<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nnu.edu.station.dao.waterdata.WaterDataMapper">
    <select id="getWaterStationData" resultType="java.util.Map">
        select * from water_data where swzmc = #{station} and clsj between #{startTime} and #{endTime}
    </select>
</mapper>