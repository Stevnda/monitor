<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="nnu.edu.station.dao.level.WaterDataMapper">
    <select id="getWaterStationData" resultType="java.util.Map">
        select * from ${station} where time between #{startTime} and #{endTime}
    </select>
</mapper>